# Puerto donde correra el servidor
PORT=5000

# Cadena de conexion a MongoDB Atlas
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/bitacora-mantenimiento

# Secreto para firmar los tokens JWT (usa una cadena larga y aleatoria)
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_seguro

# Tiempo de expiracion del token
JWT_EXPIRES_IN=7d

# URL del frontend desplegado, para configurar CORS
CLIENT_URL=http://localhost:5173
