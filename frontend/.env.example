# Modo de datos: "local" (por defecto) usa localStorage en el navegador,
# ideal para desplegar solo el frontend en GitHub Pages sin backend.
# Cambialo a "api" cuando tengas el backend desplegado y quieras conectarte a el.
VITE_DATA_MODE=local

# URL base de la API del backend (solo se usa si VITE_DATA_MODE=api)
VITE_API_URL=http://localhost:5000/api
